{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Fey-inspired design tokens",
  "version": "1.0.0",
  "fontFamily": "-apple-system, BlinkMacSystemFont, SF Pro Text, SF Pro Display, system-ui, Segoe UI, sans-serif",
  "colors": {
    "background": "#000000",
    "surface": "#0b0b0b",
    "raised": "#131313",
    "inset": "#1a1b20",
    "ink": "#ffffff",
    "high": "#e6e6e6",
    "mid": "#868f97",
    "low": "#787878",
    "gain": "#4ebe96",
    "loss": "#ef5350",
    "link": "#479ffa",
    "highlight": "#ffa16c"
  },
  "radii": { "card": "16px", "nested": "12px", "pill": "999px", "key": "6px" },
  "spacing": { "cardPadding": "18px", "controlHeight": "40px", "iconButton": "32px" },
  "shadows": {
    "overlay": "0 0 44px rgba(0,0,0,0.8)",
    "sticky": "0 0 35px rgba(0,0,0,0.5)",
    "card": "none"
  },
  "borders": { "hairline": "1px solid rgba(255,255,255,0.1)", "card": "none" },
  "typeScale": { "hero": "54px", "section": "26px", "title": "18px", "body": "14px", "label": "12px" }
}
